# Copiar a .env.local y completar valores. NUNCA commitear .env*.local.
# Las variables con prefijo VITE_ se exponen al bundle del navegador (seguras por diseño).

# --- Supabase (cliente, se expone al frontend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (servidor, bypassa RLS — NUNCA en el frontend) ---
# Solo se usa dentro de Vercel Functions (api/). En local, cargala con `supabase start` o desde el dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor ---
# Google Sheet ID del catálogo del proveedor (parte del URL entre /d/ y /edit).
VITE_PROVIDER_SHEET_ID=1O-zrDpH7-vKnegG38pm8u4qIoY9NySsJD2T8WGRjbtk

# --- Negocio ---
# WhatsApp al que se notifica el pedido al confirmar (formato internacional sin +, ej. 5491134632133).
VITE_BUSINESS_WHATSAPP=
